profiles/

# 编辑器/系统
.DS_Store
Thumbs.db
*.swp

# 中间迭代构建产物（仅发布件 PenBili.amr 入库）
8002026091900004.*.amr

# 服务端 HLS 分片缓存（运行时产物）
server/hls_cache/

# Python 运行时缓存
__pycache__/
