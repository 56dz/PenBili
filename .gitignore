# 依赖与构建产物
node_modules/
.falcon_/
.falcon_tmp/
.tmpbuild/
*.log

# 本地工具（便携 git 等，不入库）
.tools/

# 服务器 SSH 凭据脚本（含明文口令，绝不入库）
tools/srv*.py

# 真机取证截图与临时脚本（含设备画面，不入库；需要的图已筛进 docs/screenshots/）
shots/
.tmp/

# Release 附件的本地副本（附件挂在 GitHub Release 页）
PenBili.zip
PenBili-server.zip

# 运行时/本地状态（种子与设备状态，不含凭据，但不入库）
.deploy/

# 本地设备画像、真机证据（可能包含设备标识、账号信息或网络信息）
profiles/

# 编辑器/系统
.DS_Store
Thumbs.db
*.swp

# 中间迭代构建产物（仅发布件 PenBili.amr 入库）
# 用通配而非写死 appid：AppID 换过一次（8002026091900004 → 8002026110200001），
# 写死会让新 appid 的产物被误提交。
8002*.amr
8080*.amr

# Python 运行时缓存
__pycache__/
